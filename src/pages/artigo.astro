---
import Layout from '../layouts/Layout.astro';
---
<Layout titulo="Artigo | Blog da Mariana">
  <main id="conteudo" class="container pagina-artigo">
    <a class="voltar" href={`${import.meta.env.BASE_URL}/index.html#artigos`}>← Voltar aos artigos</a>
    <p id="status-artigo" role="status">Carregando artigo...</p>
    <article id="artigo" hidden>
      <header>
        <p class="etiqueta">Publicação do blog</p>
        <h1 id="artigo-titulo"></h1>
        <p id="artigo-data" class="data-artigo"></p>
      </header>
      <div id="artigo-conteudo"></div>
    </article>
  </main>
</Layout>

<script>
  import "../scripts/artigo.js";
</script>
